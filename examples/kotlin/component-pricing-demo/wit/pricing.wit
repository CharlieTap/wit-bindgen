package example:pricing@1.0.0;

interface pricing-types {
    enum customer-tier {
        standard,
        preferred,
        enterprise,
    }

    enum tax-region {
        exempt,
        uk,
        eu,
        us,
    }

    record quote-request {
        sku: string,
        quantity: s32,
        unit-price-minor: s64,
        customer-tier: customer-tier,
        tax-region: tax-region,
        currency: string,
    }

    record line-item {
        description: string,
        amount-minor: s64,
    }

    record pricing-model-data {
        eligibility-flags: list<bool>,
        feature-bytes: list<u8>,
        signed-feature-bytes: list<s8>,
        category-codes: list<u16>,
        seasonal-adjustments: list<s16>,
        observation-counts: list<u32>,
        demand-adjustments: list<s32>,
        revenue-buckets: list<u64>,
        balance-adjustments: list<s64>,
        confidence-scores: list<f32>,
        calibration-values: list<f64>,
        currency-symbols: list<char>,
    }

    record price-quote {
        sku: string,
        subtotal-minor: s64,
        discount-minor: s64,
        tax-minor: s64,
        adjustments: list<line-item>,
        total-minor: s64,
        currency: string,
        summary: string,
        model-data: pricing-model-data,
    }

}

interface pricing {
    use pricing-types.{quote-request, price-quote};

    quote: func(request: quote-request) -> price-quote;
}

world pricing-component {
    import pricing-types;
    export pricing;
}
