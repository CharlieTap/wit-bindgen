package example:pricing@1.0.0;

interface pricing-types {
    enum customer-tier {
        standard,
        preferred,
        enterprise,
    }

    enum tax-region {
        exempt,
        uk,
        eu,
        us,
    }

    record quote-request {
        sku: string,
        quantity: s32,
        unit-price-minor: s64,
        customer-tier: customer-tier,
        tax-region: tax-region,
        currency: string,
    }

    record line-item {
        description: string,
        amount-minor: s64,
    }

    record price-quote {
        sku: string,
        subtotal-minor: s64,
        discount-minor: s64,
        tax-minor: s64,
        adjustments: list<line-item>,
        total-minor: s64,
        currency: string,
        summary: string,
    }

}

interface pricing {
    use pricing-types.{quote-request, price-quote};

    quote: func(request: quote-request) -> price-quote;
}

world pricing-component {
    import pricing-types;
    export pricing;
}
