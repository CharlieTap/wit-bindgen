package example:pricing@1.0.0;

interface pricing {
    enum customer-tier {
        standard,
        preferred,
        enterprise,
    }

    enum tax-region {
        exempt,
        uk,
        eu,
        us,
    }

    record quote-request {
        sku: string,
        quantity: s32,
        unit-price-minor: s64,
        customer-tier: customer-tier,
        tax-region: tax-region,
        currency: string,
    }

    record price-quote {
        sku: string,
        subtotal-minor: s64,
        discount-minor: s64,
        tax-minor: s64,
        total-minor: s64,
        currency: string,
        summary: string,
    }

    quote: func(request: quote-request) -> price-quote;
}

world pricing-component {
    export pricing;
}
